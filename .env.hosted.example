# HLBuilder config for the root docker-compose.yml:
#   cp .env.hosted.example .env
#   docker compose up -d            # the published images
#   docker compose up -d --build    # built from this checkout
# Every variable has a default in docker-compose.yml; set only what you change.

# Port of the web app. Open http://localhost:3000 after startup. The app's
# nginx passes /api, /auth and /mcp on to the backend, which has no port of its own.
FRONTEND_PORT=3000
# Image tag of the published images.
# HLBUILDER_TAG=latest

# The bundled Postgres container. Keep DB_HOST=postgres with the included
# docker-compose.yml; set DB_PASSWORD to something private if the data matters.
DB_HOST=postgres
DB_PORT=5432
DB_USER=homelab
DB_NAME=homelab_builder
DB_PASSWORD=homelab_password
DB_SSLMODE=disable

# Login. Leave GOOGLE_CLIENT_ID empty for a local workspace without login
# (trusted networks only). For a public instance set GOOGLE_CLIENT_ID,
# a long random JWT_SECRET and GIN_MODE=release.
GIN_MODE=debug
GOOGLE_CLIENT_ID=
JWT_SECRET=

TZ=Europe/Berlin

# MCP endpoint and AI assistant (docs/MCP.md, docs/AI-ASSISTANT-SECURITY.md).
# LLM clients connect to http://<this host>:3000/mcp with a personal access
# token created in Settings.
MCP_ENABLED=true
# Browser origins allowed to call /mcp cross-origin (comma-separated). Usually empty.
MCP_ALLOWED_ORIGINS=
ASSISTANT_ENABLED=true
# Master key for stored provider keys and Proxmox token secrets: base64 of 32
# random bytes (openssl rand -base64 32). Required on a public instance (login
# on, GIN_MODE=release), where the assistant stays off without it; recommended
# everywhere, since it keeps the key out of the database. Changing it makes
# stored keys unreadable: users enter them again.
SECRETS_KEY=
SECRETS_KEY_VERSION=1
# Whether the assistant may call private network addresses (a local Ollama,
# LM Studio, ...). Empty: allowed only on an instance without login.
ASSISTANT_ALLOW_PRIVATE_ENDPOINTS=
# Address you open HLBuilder at, used in review links sent to MCP clients,
# e.g. http://192.168.1.50:3000. Empty: derived from each request.
PUBLIC_APP_URL=

# Inventory and Proxmox import (docs/INVENTORY.md) work without a setting.
# INTEGRATIONS_ENABLED and INTEGRATIONS_ALLOW_PRIVATE_ENDPOINTS (see AGENTS.md,
# "Environment Variables") are not passed on by docker-compose.yml: to change
# one, add it to the backend's environment there.
