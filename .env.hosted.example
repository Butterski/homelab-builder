# HLBuilder self-hosted Docker config

# The root docker-compose.yml runs the published images (docker compose up -d),
# or builds every application service from this checkout (add --build).

# Local ports. Open http://localhost:3000 after startup.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Database settings for the bundled Postgres container.
# Keep DB_HOST=postgres when using the included docker-compose.yml.
# If you run the backend separately, DB_HOST must be a reachable PostgreSQL host.
DB_HOST=postgres
DB_PORT=5432
DB_USER=homelab
DB_NAME=homelab_builder
DB_PASSWORD=homelab_password
DB_SSLMODE=disable

# Local/trusted-network mode. Leave GOOGLE_CLIENT_ID empty to enable local admin login.
GIN_MODE=debug
GOOGLE_CLIENT_ID=
JWT_SECRET=

TZ=Europe/Berlin

# MCP endpoint and AI assistant (docs/MCP.md, docs/AI-ASSISTANT-SECURITY.md).
# Both work out of the box. LLM clients connect to http://<this host>:3000/mcp
# with a personal access token created in Settings.
MCP_ENABLED=true
ASSISTANT_ENABLED=true
# Optional but recommended: keeps the key that encrypts stored provider keys
# out of the database. Generate with: openssl rand -base64 32
SECRETS_KEY=
# Address you open HLBuilder at, used in review links sent to MCP clients,
# e.g. http://192.168.1.50:3000. Leave empty to derive it from each request.
PUBLIC_APP_URL=
