# =============================================================================
# HLBuilder — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values before deploying/running.
# =============================================================================

# ── General & Timezone ───────────────────────────────────────────────────────
TZ=Europe/Berlin

# ── Backend Configuration ────────────────────────────────────────────────────
SERVER_PORT=8080

# Database Connection (used within internal Docker network or locally)
DB_HOST=postgres
DB_PORT=5432
DB_USER=homelab
DB_PASSWORD=your_secure_db_password_here
DB_NAME=homelab_builder
DB_SSLMODE=disable
DB_TYPE=postgres

# Authentication Secrets
JWT_SECRET=your_jwt_signing_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# IPAM Microservice Address (internal Docker container name)
IPAM_URL=http://hlbipam:8081

# ── Frontend Configuration (baked into Vite build) ──────────────────────────
# In production, set this to your public domain (e.g., https://hlbldr.com).
# In local development, set this to http://localhost:8080 (the backend host).
VITE_API_URL=https://hlbldr.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ── Docker Compose Specifics ─────────────────────────────────────────────────
# Path on host to store persistent database data.
# Can be a relative path like ./postgres-data, or leave empty/remove to use Docker named volumes.
DB_PATH=./postgres-data

# Host ports to expose
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Fallback address used if VITE_API_URL is not set
IP_ADRESS=localhost

# ── MCP server and AI assistant ──────────────────────────────────────────────
# Setup and security notes: docs/MCP.md and docs/AI-ASSISTANT-SECURITY.md

# The /mcp endpoint for LLM clients (Claude Code, Cursor, VS Code, ...).
# Access always requires a personal access token created in Settings.
MCP_ENABLED=true
# Browser origins allowed to call /mcp cross-origin (comma-separated). Usually empty.
MCP_ALLOWED_ORIGINS=

# The in-app assistant. Each user brings their own provider key.
ASSISTANT_ENABLED=true
# Master key that encrypts stored provider keys: base64 of 32 random bytes.
# Generate one with: openssl rand -base64 32
# Required on a public instance (login enabled, GIN_MODE=release); without it the
# assistant stays off. Changing it makes stored keys unreadable: users re-enter them.
SECRETS_KEY=
SECRETS_KEY_VERSION=1
# Whether users may point the assistant at private network addresses (a local
# Ollama, LM Studio, ...). Leave empty for the default: allowed only when the
# instance runs without login.
ASSISTANT_ALLOW_PRIVATE_ENDPOINTS=

# Browser-facing address of the app, used in the review links MCP clients receive.
# Leave empty to derive it from each request.
PUBLIC_APP_URL=
